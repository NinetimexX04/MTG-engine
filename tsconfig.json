{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2020",
    "lib": ["ES2020"],

    /* Modules */
    "module": "Nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,

    /* Emit */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* Type Checking */
    "strict": true,
    "skipLibCheck": true,

    /* Completeness */
    "types": ["node", "vitest/globals"],
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
